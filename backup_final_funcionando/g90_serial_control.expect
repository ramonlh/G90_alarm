#!/usr/bin/expect -f

set timeout 10

set alarma_ip "192.168.1.149"
# Credenciales en g90.conf, junto a este script (no se sube a GitHub; ver g90.conf.example)
set conf [file join [file dirname [file normalize [info script]]] g90.conf]
if {![file exists $conf]} {
    puts "ERROR: falta $conf (copia g90.conf.example)"
    exit 1
}
set fh [open $conf]
foreach line [split [read $fh] "\n"] {
    if {[regexp {^\s*(ALARMA_USER|ALARMA_PASS)="?([^"]*)"?\s*$} $line -> k v]} { set cfg($k) $v }
}
close $fh
if {![info exists cfg(ALARMA_USER)] || ![info exists cfg(ALARMA_PASS)]} {
    puts "ERROR: define ALARMA_USER y ALARMA_PASS en $conf"
    exit 1
}
set usuario $cfg(ALARMA_USER)
set password $cfg(ALARMA_PASS)

if {$argc != 1} {
    puts "Uso:"
    puts "  g90_serial_control.expect arm_total"
    puts "  g90_serial_control.expect arm_parcial"
    puts "  g90_serial_control.expect disarm"
    exit 1
}

set cmd [lindex $argv 0]

if {$cmd == "arm_total"} {
    set orden {printf '\252\252\321\322\004\001\014\001\001\355' > /dev/ttyS0}
} elseif {$cmd == "arm_parcial"} {
    set orden {printf '\252\252\321\322\004\001\014\001\002\354' > /dev/ttyS0}
} elseif {$cmd == "disarm"} {
    set orden {printf '\252\252\321\322\003\001\015\000\357' > /dev/ttyS0}
} else {
    puts "Comando no reconocido: $cmd"
    puts "Comandos válidos: arm_total, arm_parcial, disarm"
    exit 2
}

spawn telnet $alarma_ip

expect {
    "login:" {
        send "$usuario\r"
    }
    timeout {
        puts "ERROR: no apareció login"
        exit 3
    }
}

expect {
    "Password:" {
        send "$password\r"
    }
    timeout {
        puts "ERROR: no apareció Password"
        exit 4
    }
}

expect {
    "#" {
        send "$orden\r"
    }
    timeout {
        puts "ERROR: no apareció shell"
        exit 5
    }
}

expect {
    "#" {
        send "exit\r"
        puts "OK: comando enviado: $cmd"
        exit 0
    }
    timeout {
        puts "AVISO: comando enviado, pero no volvió el prompt"
        exit 0
    }
}
